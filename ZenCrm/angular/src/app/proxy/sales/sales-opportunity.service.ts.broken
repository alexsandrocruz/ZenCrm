import type { CreateUpdateSalesOpportunityDto, GetSalesOpportunitiesInput, SalesOpportunityDto } from './models';
import type { PipelineStage } from './pipeline-stage.enum';
import type { Priority } from './priority.enum';
import { RestService, Rest } from '@abp/ng.core';
import type { ListResultDto, PagedResultDto } from '@abp/ng.core';
import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root',
})
export class SalesOpportunityService {
  apiName = 'Default';

  constructor(private restService: RestService) {}

  associateWithClient = (id: string, clientId: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/associate-with-client/${clientId}`,
    },
    { apiName: this.apiName,...config });
  

  closeLost = (id: string, lostReason: string, competitor?: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/close-lost`,
      params: { lostReason, competitor },
    },
    { apiName: this.apiName,...config });
  

  closeWon = (id: string, actualValue?: number, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/close-won`,
      params: { actualValue },
    },
    { apiName: this.apiName,...config });
  

  create = (input: CreateUpdateSalesOpportunityDto, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: '/api/app/sales-opportunity',
      body: input,
    },
    { apiName: this.apiName,...config });
  

  delete = (id: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, void>({
      method: 'DELETE',
      url: `/api/app/sales-opportunity/${id}`,
    },
    { apiName: this.apiName,...config });
  

  get = (id: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'GET',
      url: `/api/app/sales-opportunity/${id}`,
    },
    { apiName: this.apiName,...config });
  

  getByOwner = (ownerId: string, input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: `/api/app/sales-opportunity/by-owner/${ownerId}`,
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getByStage = (stage: PipelineStage, input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/by-stage',
      params: { stage, filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getHighValueOpportunities = (minValue: number, input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/high-value-opportunities',
      params: { minValue, filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getList = (input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity',
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getLostOpportunities = (input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/lost-opportunities',
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getMyOpportunities = (input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/my-opportunities',
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getOverdueOpportunities = (input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/overdue-opportunities',
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  getStageOptions = (config?: Partial<Rest.Config>) =>
    this.restService.request<any, ListResultDto<enum>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/stage-options',
    },
    { apiName: this.apiName,...config });
  

  getWonOpportunities = (input: GetSalesOpportunitiesInput, config?: Partial<Rest.Config>) =>
    this.restService.request<any, PagedResultDto<SalesOpportunityDto>>({
      method: 'GET',
      url: '/api/app/sales-opportunity/won-opportunities',
      params: { filter: input.filter, stage: input.stage, priority: input.priority, ownerUserId: input.ownerUserId, salesLeadId: input.salesLeadId, clientId: input.clientId, parentOpportunityId: input.parentOpportunityId, startDate: input.startDate, endDate: input.endDate, expectedCloseDateStart: input.expectedCloseDateStart, expectedCloseDateEnd: input.expectedCloseDateEnd, minEstimatedValue: input.minEstimatedValue, maxEstimatedValue: input.maxEstimatedValue, minProbability: input.minProbability, maxProbability: input.maxProbability, isActive: input.isActive, isClosed: input.isClosed, isOverdue: input.isOverdue, competitor: input.competitor, sorting: input.sorting, skipCount: input.skipCount, maxResultCount: input.maxResultCount },
    },
    { apiName: this.apiName,...config });
  

  moveToStage = (id: string, newStage: PipelineStage, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/move-to-stage`,
      params: { newStage },
    },
    { apiName: this.apiName,...config });
  

  setParentOpportunity = (id: string, parentOpportunityId: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/set-parent-opportunity/${parentOpportunityId}`,
    },
    { apiName: this.apiName,...config });
  

  setPriority = (id: string, priority: Priority, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'POST',
      url: `/api/app/sales-opportunity/${id}/set-priority`,
      params: { priority },
    },
    { apiName: this.apiName,...config });
  

  update = (id: string, input: CreateUpdateSalesOpportunityDto, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'PUT',
      url: `/api/app/sales-opportunity/${id}`,
      body: input,
    },
    { apiName: this.apiName,...config });
  

  updateExpectedCloseDate = (id: string, date: string, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'PUT',
      url: `/api/app/sales-opportunity/${id}/expected-close-date`,
      params: { date },
    },
    { apiName: this.apiName,...config });
  

  updateExpectedValue = (id: string, value: number, config?: Partial<Rest.Config>) =>
    this.restService.request<any, SalesOpportunityDto>({
      method: 'PUT',
      url: `/api/app/sales-opportunity/${id}/expected-value`,
      params: { value },
    },
    { apiName: this.apiName,...config });
}
